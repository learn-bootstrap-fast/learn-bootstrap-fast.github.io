{
  "query": "You are the Database Engineer for a streaming media startup that is building a customer-facing web app with heavy traffic. The system must handle 700 reads per second and 900 writes per second and it needs approximately 1.5 TB of total storage. Given these constraints, which Firestore mode and storage configuration should you implement to satisfy both performance and capacity requirements?",
  "options": [
    {
      "text": "Firestore in Datastore mode with 1.5 TB SSD storage",
      "explanation": "This uses the Datastore compatibility mode and relies on SSD-backed managed storage.",
      "correct": false,
      "selected": false
    },
    {
      "text": "Firestore in Native mode with 1.5 TB HDD storage",
      "explanation": "This selects Firestore&apos;s document model while assuming a hard disk option for the underlying storage.",
      "correct": false,
      "selected": false
    },
    {
      "text": "Firestore in Native mode with 1.5 TB SSD storage",
      "explanation": "This chooses Firestore&apos;s recommended document model and relies on fully managed SSD-backed storage.",
      "correct": true,
