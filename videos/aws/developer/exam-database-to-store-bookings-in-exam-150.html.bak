{
  "query": "A language learning startup stores enrollment data in Cloud Spanner in a table named enrollments with columns learner_id, course_id, and locale. The team needs to run frequent lookups for the courses that a specific learner is taking in a specific locale and they want the query to be parameterized for best performance. Which SQL should you use?",
  "options": [
    {
      "text": "SELECT course_id FROM enrollments WHERE learner_id LIKE @learnerId AND locale=@locale",
      "explanation": "This statement uses a pattern match on the learner identifier and an equality predicate on the locale.",
      "correct": false,
      "selected": false
    },
    {
      "text": "SELECT course_id FROM enrollments WHERE learner_id=@learnerId AND locale=@locale",
      "explanation": "This statement applies parameterized equality filters on both the learner identifier and locale.",
      "correct": true,
      "selected": false
    },
    {
      "text": "SELECT course_id FROM enrollments WHERE learner_id=@learnerId AND locale=&apos;en_US&apos;",
      "explanation": "This statement mixes a parameter for the learner identifier with a fixed literal value for the locale.",
      "correct": false,
      "selected": false
    },
    {
      "text": "SELECT course_id FROM enrollments WHERE learner_id=@learnerId AND locale LIKE @locale",
      "explanation": "This statement uses an equality filter for the learner identifier and a pattern match for the locale.",
      "correct": false,
